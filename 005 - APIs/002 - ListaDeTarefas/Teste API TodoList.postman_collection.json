    {
      "name": "Gerar nova tarefa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Nega a possibilidade de cenarios vazios acontecerem\r",
              "pm.test(\"Status 400 Bad Request\", () => {\r",
              "    pm.response.to.have.status(400);\r",
              "});\r",
              "\r",
              "pm.test(\"Status 201 Created\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Retorna JSON\", () => {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Tarefa tem Id e DataCriacao preenchidos pelo servidor\", () => {\r",
              "    const tarefa = pm.response.json();\r",
              "    pm.expect(tarefa.id).to.eql(1);\r",
              "    pm.expect(tarefa.dataCriacao).to.not.be.null;\r",
              "});\r",
              "\r",
              "// Salva o ID para usar nas próximas requisições\r",
              "const tarefa = pm.response.json();\r",
              "pm.collectionVariables.set(\"tarefaId\", tarefa.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
